+
+def test_shipped_dashboard_allows_human_reviewers_to_complete_review_cards():
+    """The backend accepts review -> done; the shipped UI must expose that action."""
+    repo_root = Path(__file__).resolve().parents[2]
+    dashboard = (repo_root / "plugins" / "kanban" / "dashboard" / "dist" / "index.js").read_text()
+    complete_action = 'b(tx(t, "complete", "Complete"),  { status: "done" },'
+    start = dashboard.index(complete_action)
+    enabled_when = dashboard[start:dashboard.index('getDestructiveConfirm(t, "done")', start)]
+    assert 'task.status === "review"' in enabled_when
+
