+def _strip_runtime_notices(text: Optional[str]) -> Optional[str]:
+    """Drop runtime notices Hermes delivers in the user role; None when nothing the user wrote is left.
+
+    Whole-turn notices (background-process exits, subagent and delegation completions) reuse the
+    session timeline's synthetic-prompt pattern. Reaction notes are stripped from the front of a
+    real message, which is kept.
+    """
