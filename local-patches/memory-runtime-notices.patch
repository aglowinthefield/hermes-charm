diff --git a/tests/agent/test_memory_runtime_notices.py b/tests/agent/test_memory_runtime_notices.py
new file mode 100644
index 0000000000..17ce7408f4
--- /dev/null
+++ b/tests/agent/test_memory_runtime_notices.py
@@ -0,0 +1,53 @@
+"""MemoryManager keeps Hermes's own user-role notices out of memory providers.
+
+Background-process and subagent completions arrive as user-role turns, and reaction notes are
+prepended to the user's message. Extraction backends otherwise store them as facts about the user
+("User's background process proc_x completed with exit code 0").
+"""
+
+import pytest
+
+from agent.memory_manager import MemoryManager
+from tests.agent.test_memory_skill_scaffolding import _manager_with_recorder
+
+_PROCESS_TURN = (
+    "[IMPORTANT: Background process proc_abc123 completed (exit_code=0).\n"
+    "Command: gh pr checks 3980\nOutput:\nall green\n]"
+)
+_SUBAGENT_TURN = "A background subagent you dispatched earlier has finished. Result: done."
+_REACTIONS_ONLY = (
+    '[The user reacted ❤️ to your message: "Pushed."]\n'
+    "[The user reacted 👍 to your earlier message]"
+)
+_REACTIONS_THEN_WORDS = '[The user reacted ❤️ to your message: "Pushed."]\n\nyes, do both weekly'
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (_PROCESS_TURN, None),
+        (_SUBAGENT_TURN, None),
+        (_REACTIONS_ONLY, None),
+        (_REACTIONS_THEN_WORDS, "yes, do both weekly"),
+        ("[The user reacted to the plan] mid-sentence brackets stay", "[The user reacted to the plan] mid-sentence brackets stay"),
+        ("plain message", "plain message"),
+    ],
+)
+def test_provider_text(text, expected):
+    assert MemoryManager._provider_text(text) == expected
+
+
+def test_sync_all_skips_process_notice_and_keeps_words_after_reactions():
+    mgr, provider = _manager_with_recorder()
+    mgr.sync_all(_PROCESS_TURN, "That's the run I already reported.")
+    mgr.sync_all(_REACTIONS_THEN_WORDS, "Doing both.")
+    mgr.flush_pending(timeout=5.0)
+    assert provider.synced == ["yes, do both weekly"]
+
+
+def test_prefetch_skips_reaction_only_turn():
+    mgr, provider = _manager_with_recorder()
+    assert mgr.prefetch_all(_REACTIONS_ONLY) == ""
+    mgr.queue_prefetch_all(_SUBAGENT_TURN)
+    mgr.flush_pending(timeout=5.0)
+    assert provider.prefetched == [] and provider.queued == []
