+    (skill / 'SKILL.md').write_text('---\nname: known\ndescription: fixture\n---\n', encoding='utf-8')
+    actor = Principal('owner', str(tmp_path), frozenset({'session:create'}), 'transport')
+    connection = SimpleNamespace(authority=SimpleNamespace(profile_id=str(tmp_path)), actor=actor, native_owner=True)
+    params = dict(board='pins', task_id=task.id, run_id=task.current_run_id, claim_lock=task.claim_lock)
+    config = {'model': {'default': 'm', 'provider': 'custom'}, 'platform_toolsets': {'cli': ['terminal']}}
+    policy, _secrets = build_kanban_policy(connection, params, config)
