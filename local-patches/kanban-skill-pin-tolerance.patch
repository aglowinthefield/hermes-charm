+        conn.execute('UPDATE tasks SET skills = ? WHERE id = ?', (json.dumps(['known', 'revenueos']), task_id))
+        kb.recompute_ready(conn)
+        task = kb.claim_task(conn, task_id)
+    skill = tmp_path / 'skills' / 'general' / 'known'
