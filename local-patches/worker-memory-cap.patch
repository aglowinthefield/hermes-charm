+def _worker_memory_cap_bytes() -> int:
+    """Ceiling on the half-of-RAM bound. ``HERMES_WORKER_MEMORY_MAX_CAP_MB`` replaces the 4 GiB
+    default for hosts whose workers run whole-monorepo typecheck/test (4 GiB OOM-kills them). It
+    can raise the ceiling but never past half of RAM or the gateway's own cgroup limit."""
+    raw = os.getenv("HERMES_WORKER_MEMORY_MAX_CAP_MB", "").strip()
+    if raw:
+        try:
+            parsed = int(raw) * 1024 * 1024
+        except ValueError:
+            parsed = -1
+        if parsed >= _MIN_WORKER_MEMORY_MAX_BYTES:
+            return parsed
+        logger.warning(
+            "Ignoring invalid HERMES_WORKER_MEMORY_MAX_CAP_MB=%r; "
+            "expected an integer representing at least %d MiB",
+            raw, _MIN_WORKER_MEMORY_MAX_BYTES // (1024 * 1024))
+    return _WORKER_MEMORY_MAX_CAP_BYTES
+
+
+def _worker_slice_argv() -> List[str]:
+    """``--slice`` for ``HERMES_WORKER_SLICE`` so every worker scope shares one aggregate
+    memory ceiling (set MemoryMax on that slice unit); empty when unset or not a .slice name."""
+    name = os.getenv("HERMES_WORKER_SLICE", "").strip()
+    if not name:
+        return []
+    if not name.endswith(".slice") or "/" in name:
+        logger.warning("Ignoring invalid HERMES_WORKER_SLICE=%r; expected a *.slice unit name", name)
+        return []
+    return ["--slice", name]
+
+
