+    def test_worker_memory_cap_env_raises_ceiling_within_half_ram(self, monkeypatch):
+        import tools.process_registry as pr
+
+        gib = 1024 * 1024 * 1024
+        monkeypatch.delenv("TERMINAL_LOCAL_MEMORY_MAX_MB", raising=False)
+        monkeypatch.setattr(pr.Path, "read_text", lambda *_a, **_k: "0::/\n")
+        pages = {"SC_PHYS_PAGES": (64 * gib) // 4096, "SC_PAGE_SIZE": 4096}
+        monkeypatch.setattr(pr.os, "sysconf", lambda name: pages[name])
+
+        monkeypatch.delenv("HERMES_WORKER_MEMORY_MAX_CAP_MB", raising=False)
+        assert pr._worker_memory_max_bytes() == 4 * gib
+
+        monkeypatch.setenv("HERMES_WORKER_MEMORY_MAX_CAP_MB", str(12 * 1024))
+        assert pr._worker_memory_max_bytes() == 12 * gib
+
+        # Still bounded by half of physical RAM.
+        monkeypatch.setenv("HERMES_WORKER_MEMORY_MAX_CAP_MB", str(100 * 1024))
+        assert pr._worker_memory_max_bytes() == 32 * gib
+
+        monkeypatch.setenv("HERMES_WORKER_MEMORY_MAX_CAP_MB", "nope")
+        assert pr._worker_memory_max_bytes() == 4 * gib
+
+    def test_worker_slice_env_places_scope_in_slice(self, monkeypatch):
+        import tools.process_registry as pr
+
+        monkeypatch.setenv("HERMES_WORKER_SLICE", "hermes-workers.slice")
+        argv = pr._systemd_scope_argv("/usr/bin/systemd-run", "u", "true")
+        assert argv[argv.index("--slice") + 1] == "hermes-workers.slice"
+
+        monkeypatch.setenv("HERMES_WORKER_SLICE", "../evil")
+        assert "--slice" not in pr._systemd_scope_argv("/usr/bin/systemd-run", "u", "true")
+
+        monkeypatch.delenv("HERMES_WORKER_SLICE")
+        assert "--slice" not in pr._systemd_scope_argv("/usr/bin/systemd-run", "u", "true")
+
